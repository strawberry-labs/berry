{
	admin off
	# Direct binary uploads intermittently stalled over HTTP/3 between Chromium
	# and the MinIO reverse proxy. Keep the public edge on the mature HTTP/1.1
	# and HTTP/2 paths until the QUIC upload path is proven safe.
	servers {
		protocols h1 h2
	}
}

{$BERRY_DOMAIN} {
	@not_event_streams {
		not path /v1/sessions/*/events /v1/tasks/*/events
	}
	encode @not_event_streams zstd gzip

	@event_streams path /v1/sessions/*/events /v1/tasks/*/events
	header @event_streams {
		Cache-Control "no-cache, no-transform"
		X-Accel-Buffering "no"
	}

	@immutable_assets path /assets/*
	header @immutable_assets Cache-Control "public, max-age=31536000, immutable"

	@untrusted_file_responses path /v1/files/*/content /v1/artifacts/* /v1/branding/*
	header @untrusted_file_responses {
		Content-Security-Policy "default-src 'none'; sandbox"
		X-Frame-Options "DENY"
	}

	@application_responses {
		not path /v1/files/*/content /v1/artifacts/* /v1/branding/*
	}
	header @application_responses {
		# The web SSR emits a per-response nonce-bearing CSP. Do not add a
		# second static policy here: browsers intersect multiple policies and a
		# stale edge policy would either break SSR hydration or re-enable inline
		# script execution.
		X-Frame-Options "SAMEORIGIN"
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 40MB
	}

	@api path /v1/* /healthz /readyz
	reverse_proxy @api api:3000 {
		header_up X-Berry-Client-IP {http.request.remote.host}
		flush_interval -1
	}

	reverse_proxy web:3108

	log {
		output stdout
		format json
	}
}

import {$BERRY_STORAGE_PROXY_IMPORT:/etc/caddy/storage/minio/*.caddy}
