# Public host. DNS A/AAAA must point here before Caddy requests TLS.
BERRY_DOMAIN=ai.example.com
BERRY_DEPLOYMENT_PROFILE=production
BERRY_WEB_PUBLIC_URL=https://ai.example.com
DEPLOYMENT_MODE=self-hosted
BERRY_WEB_API_BASE_URL=https://ai.example.com
# Server-only URL for SSR session checks. Compose supplies http://api:3000.
BERRY_WEB_API_INTERNAL_URL=http://api:3000
BERRY_AUTH_BASE_URL=https://ai.example.com
# Optional: keep blank for /v1/auth/callback/google, or set an existing
# enterprise callback URI on the same origin under /v1/auth/.
BERRY_AUTH_GOOGLE_REDIRECT_URI=
BERRY_AUTH_TRUSTED_ORIGINS=https://ai.example.com
BERRY_API_CORS_ORIGINS=https://ai.example.com
BERRY_PROMETHEUS_PORT=9090
BERRY_PROMETHEUS_RETENTION=15d
BERRY_ALERTMANAGER_PORT=9093
BERRY_ALERTMANAGER_RETENTION=120h
# CloudFormation output AlertTopicArn. Blank keeps the alert UI running but
# disables external notifications, so production rollout must populate it.
BERRY_ALERT_SNS_TOPIC_ARN=
BERRY_ALERT_SNS_REGION=eu-west-1

# Generate the database and webhook values independently with
# `openssl rand -hex 32` (hex stays URL-safe in BERRY_DATABASE_URL and setup
# links). Generate BETTER_AUTH_SECRET with `openssl rand -base64 36`.
BERRY_API_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_API_DATABASE_PASSWORD
BERRY_WORKER_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_WORKER_DATABASE_PASSWORD
BERRY_PLATFORM_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_PLATFORM_DATABASE_PASSWORD
BERRY_MEM0_POSTGRES_DB=mem0
BERRY_MEM0_POSTGRES_USER=mem0
BERRY_MEM0_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_MEM0_DATABASE_PASSWORD
# Private RDS URLs. Use one RDS instance with separate `berry` and `mem0`
# databases, require TLS, and keep the instance outside the public internet.
BERRY_DATABASE_URL=postgres://REPLACE_WITH_RDS_SCHEMA_OWNER:REPLACE_WITH_RDS_OWNER_PASSWORD@REPLACE_WITH_RDS_HOST:5432/berry?sslmode=require
BERRY_API_DATABASE_URL=postgres://berry_api:REPLACE_WITH_RANDOM_API_DATABASE_PASSWORD@REPLACE_WITH_RDS_HOST:5432/berry?sslmode=require
BERRY_WORKER_DATABASE_URL=postgres://berry_worker:REPLACE_WITH_RANDOM_WORKER_DATABASE_PASSWORD@REPLACE_WITH_RDS_HOST:5432/berry?sslmode=require
BERRY_PLATFORM_DATABASE_URL=postgres://berry_platform:REPLACE_WITH_RANDOM_PLATFORM_DATABASE_PASSWORD@REPLACE_WITH_RDS_HOST:5432/berry?sslmode=require
BERRY_MEM0_DATABASE_URL=postgres://REPLACE_WITH_RDS_MEM0_USER:REPLACE_WITH_RDS_MEM0_PASSWORD@REPLACE_WITH_RDS_HOST:5432/mem0?sslmode=require
BERRY_MEM0_DATABASE_POOL_MAX=10
BERRY_MEM0_DATABASE_CONNECTION_TIMEOUT_MS=5000
BERRY_MEM0_DATABASE_IDLE_TIMEOUT_MS=30000
BERRY_MEM0_DATABASE_QUERY_TIMEOUT_MS=5000
BERRY_MEM0_DATABASE_STATEMENT_TIMEOUT_MS=5000
BERRY_OUTBOX_DISPATCH_ENABLED=true
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_36
BERRY_SETUP_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
BERRY_USAGE_SIGNING_SECRETS=router-prod:REPLACE_WITH_RANDOM_USAGE_WEBHOOK_SECRET

# The setup email may claim the first and only initial owner through Google.
# Setup closes automatically after that transaction. Password login and local
# signup remain disabled for every user, including the owner.
BERRY_AUTH_MODE=better-auth
BERRY_SETUP_OWNER_EMAIL=REPLACE_WITH_OWNER_EMAIL
BERRY_AUTH_LOGIN_METHODS=google
BERRY_AUTH_SIGNUP_ENABLED=false
BERRY_AUTH_MAX_USERS=300
BERRY_DEFAULT_ORG_MONTHLY_BUDGET_MICROS=100000000
BERRY_DEFAULT_USER_MONTHLY_BUDGET_MICROS=15000000
BERRY_AUTH_ALLOWED_EMAILS=
BERRY_AUTH_ALLOWED_EMAIL_DOMAINS=
BERRY_AUTH_ALLOW_OPEN_SIGNUP=false
BERRY_AUTH_IP_ADDRESS_HEADERS=x-berry-client-ip,x-forwarded-for
BERRY_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
BERRY_AUTH_RATE_LIMIT_MAX=30
BERRY_AUTH_SOCIAL_SIGN_IN_RATE_LIMIT_WINDOW_SECONDS=60
BERRY_AUTH_SOCIAL_SIGN_IN_RATE_LIMIT_MAX=600

# BerryRouter inference. The base URL should normally end in /v1.
BERRY_API_MODEL_MODE=live
BERRY_ROUTER_INFERENCE_BASE_URL=https://REPLACE_WITH_BERRYROUTER_HOST/v1
BERRY_ROUTER_API_KEY=REPLACE_WITH_BERRYROUTER_INFERENCE_KEY
BERRY_ROUTER_PROVIDER_ID=router
BERRY_ROUTER_PROVIDER_NAME=Berry Router
BERRY_ROUTER_CHAT_COMPLETIONS_PATH=/chat/completions
BERRY_ROUTER_COMPLETION_TRANSPORT=stream
BERRY_ROUTER_MODELS_PATH=/models
BERRY_ROUTER_DEFAULT_MODEL=REPLACE_WITH_KIMI_2_6_MODEL_ID
BERRY_ORGANIZATION_PROVIDER_ALLOWED_HOSTS=REPLACE_WITH_BERRYROUTER_HOST
BERRY_ORGANIZATION_PROVIDER_ALLOW_INSECURE_HTTP=false
# Optional JSON object for additional provider credential references used by
# Settings → AI & tools → Providers. Keep this value in the untracked env file.
BERRY_ORGANIZATION_PROVIDER_CREDENTIALS_JSON={}
# Shared by API and Worker. Generate with: openssl rand -base64 32
BERRY_DURABLE_CAPABILITY_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
# Separate root key for connector credentials in PostgreSQL.
# Generate with: openssl rand -base64 32
BERRY_CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_A_DIFFERENT_BASE64_32_BYTE_KEY
# Google SSO and connector OAuth client credentials are entered in Berry's
# admin UI and encrypted in Postgres with the key above; do not add them here.
# Comma-separated previous keys used only while rotating the primary key.
BERRY_CONNECTOR_DECRYPTION_KEYS=
# Deployment-wide safety ceiling. Each model's live max_output_tokens remains
# authoritative when it is lower than this value.
BERRY_CLOUD_MODEL_MAX_OUTPUT_TOKENS=384000
# Replace this entire value with one valid, single-line JSON array. Cost input/output
# values are USD per million tokens, numerically equal to micro-dollars per token.
# Keep promptCaching.supported=true only when the selected router/model supports
# the declared cache key and retention controls.
# Keep contextWindow and maxOutputTokens accurate for every deployed model; the
# composer indicator and durable compaction reserve both use these values.
BERRY_ROUTER_MODELS_JSON=[{"id":"REPLACE_WITH_KIMI_2_6_MODEL_ID","name":"Kimi 2.6","contextWindow":REPLACE_WITH_KIMI_CONTEXT_WINDOW_TOKENS,"maxOutputTokens":REPLACE_WITH_KIMI_MAX_OUTPUT_TOKENS,"inputModalities":["text","image"],"outputModalities":["text"],"capabilities":{"tools":true,"vision":true,"reasoning":true,"promptCaching":{"supported":true,"cacheKey":true,"cacheControl":false,"retention":["short","long"],"minimumTokens":1024},"cost":{"input":REPLACE_WITH_KIMI_INPUT_USD_PER_MILLION,"output":REPLACE_WITH_KIMI_OUTPUT_USD_PER_MILLION}}},{"id":"REPLACE_WITH_GLM_5_2_MODEL_ID","name":"GLM 5.2","contextWindow":REPLACE_WITH_GLM_CONTEXT_WINDOW_TOKENS,"maxOutputTokens":REPLACE_WITH_GLM_MAX_OUTPUT_TOKENS,"inputModalities":["text","image"],"outputModalities":["text"],"capabilities":{"tools":true,"vision":true,"reasoning":true,"promptCaching":{"supported":true,"cacheKey":true,"cacheControl":false,"retention":["short","long"],"minimumTokens":1024},"cost":{"input":REPLACE_WITH_GLM_INPUT_USD_PER_MILLION,"output":REPLACE_WITH_GLM_OUTPUT_USD_PER_MILLION}}}]

# BerryRouter image generation. Leave IMAGE_MODEL blank only if the feature should be disabled.
BERRY_ROUTER_IMAGE_GENERATIONS_PATH=/images/generations
BERRY_ROUTER_IMAGE_GENERATIONS_URL=
BERRY_ROUTER_IMAGE_EDITS_PATH=/images/edits
BERRY_ROUTER_IMAGE_EDITS_URL=
BERRY_ROUTER_IMAGE_MODEL=REPLACE_WITH_IMAGE_MODEL_ID
BERRY_ROUTER_IMAGE_RESPONSE_FORMAT=b64_json
BERRY_ROUTER_IMAGE_COST_MICROS=REPLACE_WITH_IMAGE_COST_IN_USD_MICROS

# E2B is called directly by the private API container. This key never reaches the browser.
BERRY_SANDBOX_PROVIDER=e2b
E2B_API_KEY=REPLACE_WITH_E2B_API_KEY
# `base` works for initial Node/Python testing. Use a reviewed custom template ID
# when you need pinned packages or a guaranteed CPU/RAM/disk shape.
BERRY_E2B_TEMPLATE_ID=base
BERRY_E2B_DOMAIN=
# Space-separated CSP origins for trusted sandbox preview frames. Use the
# matching wildcard origin if BERRY_E2B_DOMAIN is a custom domain.
BERRY_CSP_EXTRA_FRAME_SOURCES=https://*.e2b.app
BERRY_E2B_REQUEST_TIMEOUT_MS=60000
BERRY_E2B_KEEP_MEMORY_ON_PAUSE=false
# Total selected-template price in USD micros/hour (for example, $0.10/hour = 100000).
BERRY_E2B_ESTIMATED_HOURLY_COST_MICROS=REPLACE_WITH_E2B_TEMPLATE_USD_MICROS_PER_HOUR
BERRY_E2B_MINIMUM_EXEC_COST_MICROS=1
BERRY_SANDBOX_IMAGE=base
BERRY_SANDBOX_CWD=/home/user/workspace
# The sandbox auto-pauses after 5 idle minutes and reconnects by session ID.
BERRY_SANDBOX_TTL_SECONDS=300
# These values drive Berry usage estimates; keep them aligned with the E2B template.
BERRY_SANDBOX_CPU_COUNT=1
BERRY_SANDBOX_MEMORY_MIB=1024
BERRY_SANDBOX_DISK_MIB=10240

# BerryCrawl MCP. The URL must be public HTTPS and the hostname must be in the allow-list.
BERRYCRAWL_API_KEY=REPLACE_WITH_BERRYCRAWL_KEY
BERRY_CLOUD_MCP_SERVERS_JSON=[{"id":"berrycrawl","name":"BerryCrawl","transport":"streamable-http","url":"https://REPLACE_WITH_BERRYCRAWL_HOST/mcp","credentialEnv":"BERRYCRAWL_API_KEY","enabled":true,"trusted":true}]
BERRY_CLOUD_NETWORK_EGRESS=on
BERRY_CLOUD_NETWORK_ALLOWED_DOMAINS=ai.example.com,REPLACE_WITH_BERRYCRAWL_HOST,registry.npmjs.org,pypi.org,files.pythonhosted.org,github.com,api.github.com

# Registered hosted skills. Use a single-line JSON array; content is the full SKILL.md body.
BERRY_CLOUD_SKILLS_JSON='[{"name":"deep-research","description":"Conduct deep, extensive, multi-source research with BerryCrawl. Use only when the user explicitly asks for deep, extensive, comprehensive, exhaustive, or detailed research, a research report, or invokes $deep-research; do not use for ordinary questions or quick web lookups.","content":"Use BerryCrawl iteratively for an explicit deep-research request. Develop focused research questions, search across multiple authoritative sources, scrape the most relevant primary material when detail is needed, reconcile conflicts, and cite factual claims with source URLs. Keep routine web questions outside this skill.","enabled":true}]'

# Budgets and workers. Foreground turns have dedicated capacity; background
# failures cannot occupy these slots. The deployment path preserves these
# replica counts, and 10 foreground replicas at concurrency 20 is supported.
BERRY_BUDGETS_ENABLED=true
BERRY_BUDGET_FAIL_CLOSED=true
BERRY_BUDGET_SANDBOX_CREATE_ESTIMATE_MICROS=50
# Reserve a conservative maximum command cost before execution; reconciliation uses
# the runtime-derived E2B estimate above.
BERRY_BUDGET_SANDBOX_EXEC_ESTIMATE_MICROS=REPLACE_WITH_CONSERVATIVE_E2B_EXEC_RESERVATION_MICROS
BERRY_BACKGROUND_WORKER_REPLICAS=1
BERRY_BACKGROUND_WORKER_CONCURRENCY=4
BERRY_BACKGROUND_WORKER_DB_POOL_MAX=4
BERRY_FOREGROUND_WORKER_REPLICAS=5
BERRY_FOREGROUND_WORKER_CONCURRENCY=20
BERRY_FOREGROUND_WORKER_DB_POOL_MAX=5
BERRY_LEGACY_WORKER_CONCURRENCY=1
# Leave this enabled through the first split-queue rollout so jobs already in
# berry-cloud drain safely. Disable it only after that queue is confirmed empty.
BERRY_LEGACY_QUEUE_DRAIN=true
BERRY_OUTBOX_POLL_MS=250
BERRY_MCP_CONNECT_TIMEOUT_MS=10000

# Native AWS S3 in Ireland. Leave endpoint and access keys blank so the AWS SDK
# uses the EC2 instance profile. Never put long-lived IAM user keys here.
BERRY_OBJECT_STORAGE_MODE=aws
BERRY_STORAGE_PROXY_IMPORT=/etc/caddy/storage/native/*.caddy
BERRY_ARTIFACT_S3_ENDPOINT=
BERRY_ARTIFACT_S3_PUBLIC_ENDPOINT=
BERRY_ARTIFACT_S3_REGION=eu-west-1
BERRY_ARTIFACT_S3_BUCKET=REPLACE_WITH_ARTIFACT_BUCKET
BERRY_ARTIFACT_S3_ACCESS_KEY_ID=
BERRY_ARTIFACT_S3_SECRET_ACCESS_KEY=
BERRY_ARTIFACT_S3_PREFIX=artifacts
BERRY_ARTIFACT_PUBLIC_BASE_URL=https://ai.example.com/v1/artifacts
BERRY_FILE_MAX_UPLOAD_BYTES=1073741824
BERRY_KNOWLEDGE_MAX_INPUT_BYTES=104857600
BERRY_KNOWLEDGE_MAX_OUTPUT_BYTES=26214400
BERRY_SANDBOX_INPUT_MAX_BYTES=367001600
BERRY_FILE_MULTIPART_PART_SIZE=16777216
BERRY_FILE_PRESIGN_SECONDS=900

# Durable context. Embeddings stay private inside Compose.
BERRY_MEMORY_ENABLED=true
BERRY_IMPLICIT_MEMORY_ENABLED=true
BERRY_MEMORY_MODEL=canopywave/moonshotai/kimi-k2.6
BERRY_COMPACTION_MODEL=canopywave/moonshotai/kimi-k2.6
BERRY_PERSONAL_MEMORY_PROVIDER=mem0
BERRY_MEM0_API_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
BERRY_MEM0_HOST_PORT=8010
BERRY_MEM0_TIMEOUT_MS=30000
BERRY_MEM0_COLLECTION=berry_personal_memories
BERRY_MEM0_LLM_BASE_URL=REPLACE_WITH_OPENAI_COMPATIBLE_BASE_URL
BERRY_MEM0_LLM_API_KEY=REPLACE_WITH_LLM_API_KEY
BERRY_MEM0_LLM_MODEL=REPLACE_WITH_MEMORY_MODEL_ID
BERRY_MEM0_EMBEDDING_BASE_URL=http://embeddings:80/v1
BERRY_MEM0_EMBEDDING_API_KEY=berry-local-embeddings
BERRY_MEM0_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
BERRY_MEM0_EMBEDDING_DIMENSIONS=768
MEM0_TELEMETRY=false
BERRY_PROJECT_KNOWLEDGE_ENABLED=true
BERRY_PROMPT_CACHE_ENABLED=true
BERRY_DURABLE_RUNNER_ENABLED=true
BERRY_TIKA_URL=http://tika:9998
BERRY_EMBEDDING_PROVIDER=openai-compatible
BERRY_EMBEDDING_BASE_URL=http://embeddings:80/v1
BERRY_EMBEDDING_API_KEY=berry-local-embeddings
BERRY_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
BERRY_EMBEDDING_DIMENSIONS=768
BERRY_EMBEDDING_PROFILE_VERSION=2
BERRY_KNOWLEDGE_CHUNK_TOKENS=300
BERRY_KNOWLEDGE_CHUNK_OVERLAP_TOKENS=50
BERRY_RETRIEVAL_TOKEN_BUDGET=5000
BERRY_RUN_LEASE_SECONDS=90
BERRY_MODEL_IDLE_TIMEOUT_MS=240000
BERRY_MODEL_MAX_DURATION_MS=900000
BERRY_SANDBOX_SNAPSHOT_INTERVAL_SECONDS=900
BERRY_AUDIT_S3_ENDPOINT=
BERRY_AUDIT_S3_REGION=eu-west-1
BERRY_AUDIT_S3_BUCKET=REPLACE_WITH_AUDIT_BUCKET
BERRY_AUDIT_S3_ACCESS_KEY_ID=
BERRY_AUDIT_S3_SECRET_ACCESS_KEY=
BERRY_AUDIT_S3_PREFIX=audit

# Billing is deliberately disabled for this private client deployment.
BERRY_BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_BILLING_METER_EVENT_NAME=
STRIPE_CREDIT_PRICE_ID=

# Optional enterprise integrations. Blank means disabled.
BERRY_SCIM_BEARER_TOKEN=
BERRY_POLICY_SIGNING_KEY_ID=self-host-2026
BERRY_POLICY_SIGNING_PRIVATE_KEY_PEM=
BERRY_WEB_SANDBOX_TERMINAL_WS_URL=

# Loopback-only diagnostics; Caddy is the only public service.
BERRY_API_PORT=3001
BERRY_WEB_PORT=3108
