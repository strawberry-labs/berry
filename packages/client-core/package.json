{
  "name": "@berry/client-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Platform-neutral client logic shared by the Berry web app and the native mobile app.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@berry/shared": "workspace:*",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
